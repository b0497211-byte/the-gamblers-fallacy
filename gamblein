extends Node3D

# Rotations (in degrees) that put sides 1 through 6 facing UP
# Adjust these angles to match how your specific 3D die model is oriented
var face_rotations: Array[Vector3] = [
    Vector3(0, 0, 0),       # Side 1 up
    Vector3(90, 0, 0),      # Side 2 up
    Vector3(0, 0, -90),     # Side 3 up
    Vector3(0, 0, 90),      # Side 4 up
    Vector3(-90, 0, 0),     # Side 5 up
    Vector3(180, 0, 0)      # Side 6 up
]

func roll_die() -> int:
    var random_index: int = randi() % face_rotations.size()
    var target_rotation: Vector3 = face_rotations[random_index]
    
    # Smoothly spin the die to land on the chosen side
    var tween := create_tween()
    tween.tween_property(self, "rotation_degrees", target_rotation + Vector3(360, 360, 0), 0.5)
    
    var rolled_value: int = random_index + 1
    print("Rolled a ", rolled_value)
    return rolled_value
