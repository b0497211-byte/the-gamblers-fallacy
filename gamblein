extends RigidBody3D

signal roll_finished(value: int)

@onready var faces_container: Node3D = $Faces

var is_rolling: bool = false
var settle_timer: float = 0.0

func _ready() -> void:
    # Prevent the die from falling before the first roll
    freeze = true

func roll(spawn_position: Vector3) -> void:
    # Reset physics state and place the die above the table
    freeze = false
    sleeping = false
    is_rolling = true
    settle_timer = 0.0
    
    global_position = spawn_position
    linear_velocity = Vector3.ZERO
    angular_velocity = Vector3.ZERO
    
    # Give the die a random starting rotation
    rotation = Vector3(
        randf_range(0, TAU),
        randf_range(0, TAU),
        randf_range(0, TAU)
    )
    
    # Apply random sideways toss and upward pop
    var throw_impulse := Vector3(
        randf_range(-3.0, 3.0),
        randf_range(2.0, 4.0),
        randf_range(-3.0, 3.0)
    )

apply_central_impulse(throw_impulse)
    
    # Apply random spin
    var spin_impulse := Vector3(
        randf_range(-10.0, 10.0),
        randf_range(-10.0, 10.0),
        randf_range(-10.0, 10.0)
    )
    apply_torque_impulse(spin_impulse)

func _physics_process(delta: float) -> void:
    if not is_rolling:
        return

# Check if the die has nearly stopped moving
    if linear_velocity.length() < 0.05 and angular_velocity.length() < 0.05:
        settle_timer += delta
        # Wait 0.25 seconds of stillness to avoid false reads mid-bounce
        if settle_timer >= 0.25:
            is_rolling = false
            var result: int = _get_top_face()
            roll_finished.emit(result)
    else:
        settle_timer = 0.0

func _get_top_face() -> int:
    var highest_y: float = -INF
    var top_value: int = 1
    
    # Find whichever face marker is highest in world space
    for marker in faces_container.get_children():
        if marker is Marker3D:
            if marker.global_position.y > highest_y:
                highest_y = marker.global_position.y
                top_value = int(marker.name)
                
    return top_value

