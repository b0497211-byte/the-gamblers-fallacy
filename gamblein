extends Node

@export var dice_numbers: Array[int] = [1, 2, 3, 4, 5, 6]

# Replace the whole die (great for picking up a brand new die)
func edit_dice(new_numbers: Array[int]) -> void:
    if new_numbers.is_empty():
        push_error("The dice list cannot be empty.")
        return
    dice_numbers = new_numbers.duplicate()

# Upgrade or change a single face by its index (0 is the 1st face, 5 is the 6th)
func set_face(face_index: int, new_value: int) -> void:
    if face_index >= 0 and face_index < dice_numbers.size():
        dice_numbers[face_index] = new_value
    else:
        push_error("Invalid face index.")

# Add a bonus to a specific face (e.g., "+2 to face 0")
func upgrade_face(face_index: int, amount: int) -> void:
    if face_index >= 0 and face_index < dice_numbers.size():
        dice_numbers[face_index] += amount

# Add a brand new face (turns a 6-sided die into a 7-sided die)
func add_face(new_value: int) -> void:
    dice_numbers.append(new_value)

# Remove a face (trims bad numbers, like removing a 1)
func remove_face(face_index: int) -> void:
    if dice_numbers.size() <= 1:
        push_error("Cannot remove the last face of a die!")
        return
    if face_index >= 0 and face_index < dice_numbers.size():
        dice_numbers.remove_at(face_index)

# Roll the die
func roll_dice() -> int:
    return dice_numbers.pick_random()

